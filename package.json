{
  "name": "ai-lab-tycoon",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:generate": "turbo run db:generate -F @ai-lab-tycoon/db --",
    "deploy": "turbo run deploy -F @ai-lab-tycoon/infra --",
    "destroy": "turbo run destroy -F @ai-lab-tycoon/infra --",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@ai-lab-tycoon/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-lab-tycoon/config": "workspace:*",
    "@biomejs/biome": "^2.5.6",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.23.0"
}
